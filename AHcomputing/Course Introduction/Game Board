import random 
from dataclasses import dataclass
@dataclass
class square():
    position : int = 0
    player : str = ''
    pointer : int = 0 # where to move if you land here

def displayBoard(gameboard):
    for row in range(len(gameboard)):
        print(str(gameboard[row].position) + ', ', end='')
    print()

#TASK 2 
# write code to set position of each square here
def initPosition(gameboard):
    for i in range (len(gameboard)):
        gameboard[i].position = i + 1 
    return gameboard

# TASK 3 
def pointers(gameboard):
    for i in range (len(gameboard)):
        if gameboard[i].position == 5:
            gameboard[i].pointer = 8
        elif gameboard[i].position == 12:
            gameboard[i].pointer = 10
        elif gameboard[i].position == 16:
            gameboard[i].pointer = 20
        elif gameboard[i].position == 23:
            gameboard[i].pointer = 20
        elif gameboard[i].position == 27:
            gameboard[i].pointer = 29
        elif gameboard[i].position == 32:
            gameboard[i].pointer = 37
        elif gameboard[i].position == 36:
            gameboard[i].pointer = 32
        elif gameboard[i].position == 45:
            gameboard[i].pointer = 48
        elif gameboard[i].position == 48:
            gameboard[i].pointer = 46
        else: 
            gameboard[i].pointer = 0
    return gameboard 

#TASK 4
def rollDie():
    return random.randint(1,6) 
    
#TASK 4 
def movePlayer(dieResult, currentPos):
    newPos = currentPos + dieResult 
    return newPos 

