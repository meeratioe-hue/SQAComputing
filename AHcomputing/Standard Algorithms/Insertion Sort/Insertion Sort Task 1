myList = ["G","X","b","P", "z"]

countswaps = 0

for index in range (1,len(myList)):
#store the value to be inserted into the array
 currentvalue = myList[index]
 position = index


  #shift the rest of the array one to the right
 while position > 0 and ord(myList[position-1]) > ord(currentvalue):      #change the second one to < so smaller calues are shifted to the right
   myList[position] = myList[position-1]
   position -= 1
   countswaps = countswaps + 1


 #insert the value into the array
 myList[position] = currentvalue


print(myList)
print("swaps made: ", countswaps)

